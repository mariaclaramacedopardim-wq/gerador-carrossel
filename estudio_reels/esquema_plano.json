{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mariaclaramacedopardim-wq/gerador-carrossel/estudio_reels/esquema_plano.json",
  "title": "Plano de edição de Reels (edit_plan.json)",
  "description": "Plano de pré-edição. Todos os tempos estão em segundos. Tempos de segmentos referem-se ao arquivo de origem; tempos de textos e legendas referem-se ao vídeo final.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versao_esquema", "planejador", "briefing", "formato_saida", "segmentos", "textos_na_tela",
    "legendas", "audio_geral", "orientacoes_edicao", "avisos", "clipes_nao_usados", "duracao_total_estimada_s"
  ],
  "properties": {
    "versao_esquema": {"type": "string", "enum": ["1.0"]},
    "planejador": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tipo", "modelo", "observacao"],
      "properties": {
        "tipo": {
          "type": "string",
          "enum": ["demonstrativo", "claude_code", "api_anthropic", "manual"],
          "description": "Quem decidiu o plano. 'demonstrativo' = regras simples, sem IA."
        },
        "modelo": {"type": ["string", "null"], "description": "Modelo de IA usado, quando houver."},
        "observacao": {"type": "string"}
      }
    },
    "briefing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objetivo", "estilo", "historia", "duracao_alvo_s", "proporcao", "tratamento_orientacao", "ritmo", "narracao"],
      "properties": {
        "objetivo": {"type": "string"},
        "estilo": {"type": "string"},
        "historia": {"type": "string"},
        "duracao_alvo_s": {"type": "number", "minimum": 3, "maximum": 180},
        "proporcao": {"type": "string", "enum": ["9:16", "4:5", "1:1"]},
        "tratamento_orientacao": {"type": "string", "enum": ["preencher", "encaixar_desfocado", "encaixar_barras"]},
        "ritmo": {"type": "string", "enum": ["rapido", "medio", "lento"]},
        "narracao": {"type": "string", "enum": ["fala_dos_clipes", "narracao_off", "sem_fala"]}
      }
    },
    "formato_saida": {
      "type": "object",
      "additionalProperties": false,
      "required": ["largura", "altura", "fps"],
      "properties": {
        "largura": {"type": "integer", "minimum": 144, "maximum": 2160},
        "altura": {"type": "integer", "minimum": 144, "maximum": 3840},
        "fps": {"type": "integer", "enum": [24, 25, 30, 60]}
      }
    },
    "segmentos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "ordem", "arquivo_origem", "inicio_s", "fim_s", "duracao_s", "papel", "objetivo_narrativo",
          "obrigatorio", "enquadramento", "audio", "velocidade", "transicao_entrada", "tratamento_visual", "observacoes"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^S[0-9]{2,3}$"},
          "ordem": {"type": "integer", "minimum": 1},
          "arquivo_origem": {"type": "string", "minLength": 1},
          "inicio_s": {"type": "number", "minimum": 0},
          "fim_s": {"type": "number", "exclusiveMinimum": 0},
          "duracao_s": {"type": "number", "exclusiveMinimum": 0, "description": "Duração do segmento no vídeo final = (fim_s - inicio_s) / velocidade."},
          "papel": {
            "type": "string",
            "enum": ["gancho", "contexto", "desenvolvimento", "demonstracao", "prova", "virada", "conclusao", "cta", "broll"]
          },
          "objetivo_narrativo": {"type": "string"},
          "obrigatorio": {"type": "boolean"},
          "enquadramento": {
            "type": "object",
            "additionalProperties": false,
            "required": ["modo", "foco_x", "foco_y", "zoom"],
            "properties": {
              "modo": {"type": "string", "enum": ["preencher", "encaixar_desfocado", "encaixar_barras"]},
              "foco_x": {"type": "number", "minimum": 0, "maximum": 1, "description": "0 = esquerda, 0.5 = centro, 1 = direita (usado ao cortar)."},
              "foco_y": {"type": "number", "minimum": 0, "maximum": 1, "description": "0 = topo, 0.5 = centro, 1 = base (usado ao cortar)."},
              "zoom": {"type": "number", "minimum": 1, "maximum": 2}
            }
          },
          "audio": {
            "type": "object",
            "additionalProperties": false,
            "required": ["modo", "volume"],
            "properties": {
              "modo": {"type": "string", "enum": ["original", "mudo"]},
              "volume": {"type": "number", "minimum": 0, "maximum": 2}
            }
          },
          "velocidade": {"type": "number", "minimum": 0.5, "maximum": 3},
          "transicao_entrada": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tipo", "duracao_s"],
            "properties": {
              "tipo": {"type": "string", "enum": ["corte", "dissolver", "fade_preto"]},
              "duracao_s": {"type": "number", "minimum": 0, "maximum": 2}
            }
          },
          "tratamento_visual": {"type": "string"},
          "observacoes": {"type": "string"}
        }
      }
    },
    "textos_na_tela": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "texto", "inicio_s", "fim_s", "posicao", "segmento_id"],
        "properties": {
          "id": {"type": "string", "pattern": "^T[0-9]{2,3}$"},
          "texto": {"type": "string", "minLength": 1, "maxLength": 120},
          "inicio_s": {"type": "number", "minimum": 0},
          "fim_s": {"type": "number", "exclusiveMinimum": 0},
          "posicao": {"type": "string", "enum": ["topo", "centro", "inferior"]},
          "segmento_id": {"type": ["string", "null"]}
        }
      }
    },
    "legendas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fonte", "revisadas", "queimar_no_preview", "itens"],
      "properties": {
        "fonte": {"type": "string", "enum": ["nenhuma", "transcricao_automatica", "escrita_pela_criadora"]},
        "revisadas": {"type": "boolean"},
        "queimar_no_preview": {"type": "boolean"},
        "itens": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["inicio_s", "fim_s", "texto"],
            "properties": {
              "inicio_s": {"type": "number", "minimum": 0},
              "fim_s": {"type": "number", "exclusiveMinimum": 0},
              "texto": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "audio_geral": {
      "type": "object",
      "additionalProperties": false,
      "required": ["musica", "narracao", "efeitos_sonoros"],
      "properties": {
        "musica": {"type": "string", "description": "Orientação. O estúdio nunca adiciona música sozinho."},
        "narracao": {"type": "string"},
        "efeitos_sonoros": {"type": "string"}
      }
    },
    "orientacoes_edicao": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transicoes_e_efeitos", "tratamento_visual", "ajustes_no_capcut"],
      "properties": {
        "transicoes_e_efeitos": {"type": "string"},
        "tratamento_visual": {"type": "string"},
        "ajustes_no_capcut": {"type": "array", "items": {"type": "string"}}
      }
    },
    "avisos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tipo", "segmento_id", "mensagem"],
        "properties": {
          "tipo": {"type": "string", "enum": ["corte", "audio", "qualidade", "enquadramento", "duracao", "conteudo"]},
          "segmento_id": {"type": ["string", "null"]},
          "mensagem": {"type": "string"}
        }
      }
    },
    "clipes_nao_usados": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["arquivo", "motivo"],
        "properties": {"arquivo": {"type": "string"}, "motivo": {"type": "string"}}
      }
    },
    "duracao_total_estimada_s": {"type": "number", "exclusiveMinimum": 0}
  }
}
